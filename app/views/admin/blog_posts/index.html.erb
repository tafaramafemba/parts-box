<h1>Manage Blog Posts</h1>
<%= link_to 'New Blog Post', new_admin_blog_post_path, class: 'btn btn-primary' %>

<div class="table-container">
  <table class="table">
    <thead>
      <tr>
        <th>Title</th>
        <th>Author</th>
        <th>Published Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @blog_posts.each do |post| %>
        <tr>
          <td><%= post.title %></td>
          <td><%= post.author %></td>
          <td><%= post.published_date %></td>
          <td>
            <%= link_to 'Edit', edit_admin_blog_post_path(post), class: 'btn btn-warning' %>
            <%= button_to 'Delete', admin_blog_post_path(post), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<style>
  .page-title {
    text-align: center;
    margin-bottom: 20px;
  }

  .table-container {
    overflow-x: auto;
    border-radius: 5px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    background-color: #fff;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    border: none; /* Remove border from the table */
  }

  .table th, .table td {
    text-align: center;
    padding: 10px;
    border: none; /* Remove border from table cells */
  }

  .table th {
    background-color: #000;
    color: #fff;
    font-weight: bold;
  }

  .table tr:nth-child(even) {
    background-color: #f2f2f2;
  }

    .filter-forms {
    display: flex;
    flex-direction: row;
    justify-content: center;
    margin-bottom: 20px;
  }

  .form-filter {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
  }

  .form-group {
    margin-right: 10px;
    margin-bottom: 10px;
  }

  .form-control {
    display: inline-block;
    width: auto;
    margin-right: 10px;
  }

  .btn {
    display: inline-block;
    padding: 10px 15px;
    font-size: 14px;
    text-align: center;
    text-decoration: none;
    border: none;
    border-radius: 5px;
    cursor: pointer;
  }

  .btn-primary {
    background-color: #007bff;
    color: #fff;
    margin-bottom: 5px;
  }

  .btn-primary:hover {
    background-color: #0056b3;
  }

  .btn-sm {
    padding: 5px 10px;
    font-size: 12px;
  }

  @media (max-width: 768px) {
    .table th, .table td {
      font-size: 12px;
      padding: 8px;
    }

    .btn {
      font-size: 12px;
      padding: 8px 10px;
    }

    .filter-forms {
      flex-direction: column;
      align-items: center;
    }

    .form-group {
      width: 100%;
      text-align: center;
    }

    .form-control {
      width: 100%;
      margin-bottom: 10px;
    }
  }

  @media (max-width: 480px) {
    .table th, .table td {
      font-size: 10px;
      padding: 6px;
    }

    .btn {
      font-size: 10px;
      padding: 5px 8px;
    }
  }
</style>